"help_intro_text" = "Master your focus with custom voice announcements. Create timer presets and let spoken alerts keep you on pace, even while using other apps or with your screen locked.";
"help_title_basic_operation" = "Basic Operation:";
"help_basic_item_1" = "1. Set Duration: Use the sliders to choose your total focus time and interval alerts.\n";
"help_basic_item_2" = "2. Seconds Mode: Toggle 'Use Seconds' to switch the sliders from minutes to seconds for rapid interval tracking.";
"help_basic_item_3" = "3. Start & Control: Tap Start to begin. You can track, Pause, Resume, or Stop the timer directly from the app or the persistent notification.";
"help_title_managing_presets" = "Managing Presets:";
"help_manage_item_1" = "1. Save \n& Update: Type a new name and tap 'Save' to create a preset. If you modify a loaded preset's sliders or settings, tap 'Update' to overwrite it.";
"help_manage_item_2" = "2. Free Tier Limits: The free version allows up to 3 saved timer presets.";
"help_manage_item_3" = "3. Load & Delete: Tap the dropdown arrow next to the timer name to load a saved preset or open the 'Manage Timers' dialog to delete old ones.";
"help_manage_item_4" = "4. Backup & Restore: Open 'Manage Timers' to export your presets to a JSON file or import a saved backup to restore your timers.";
"help_title_settings" = "Settings & Customization:";
"help_settings_item_1" = "1. Interval Acceleration: Enabled by default, this automatically speeds up interval alerts as your timer approaches zero (e.g., intervals shrink to 2 minutes when under 10 minutes remain). Disable it in Settings to keep intervals strictly fixed.\n";
"help_settings_item_2" = "2. Voice Control: Customize the speech rate, pitch, volume, and ending phrases directly from the main panel or Settings screen.";
"help_settings_item_3" = "3. Background Audio Limiter: Choose how background media behaves during spoken announcements (Off, Lower background volume, or Pause media).";
"help_settings_item_4" = "4. Pause Reminder Beep: Set a periodic alert beep (Off, 1, 2, or 3 minutes/seconds) to sound while the timer remains paused.";
